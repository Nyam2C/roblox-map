-- Manual plaza (미관광장), cell 8930e0af10fffff, v1 (2026-10-14). Generated by src/plaza.py from the satellite photo, street view and the
-- user's photos; do not edit the tables by hand, change plaza.py and run it again. The trees come with the cell (satellite crowns).
-- Creates only; never destroys or clears anything. Made only when Manual/Plaza does not exist, so to redo it delete Manual/Plaza and run this again.
local manual = workspace:FindFirstChild("Manual")
if not manual then manual = Instance.new("Folder") manual.Name = "Manual" manual.Parent = workspace end
if manual:FindFirstChild("Plaza") then return "Manual/Plaza is already there: left alone" end
local root = Instance.new("Model") root.Name = "Plaza"
--[[DATA]]
local PAVE = 0.38
local count = 0
local function part(parent, name, size, cf, material, rgb, opts)
	local p = Instance.new("Part")
	p.Name = name p.Anchored = true p.Size = size p.CFrame = cf
	p.Material = material p.Color = Color3.fromRGB(rgb[1], rgb[2], rgb[3])
	p.TopSurface = Enum.SurfaceType.Smooth p.BottomSurface = Enum.SurfaceType.Smooth
	if opts then for k, v in opts do p[k] = v end end
	p.Parent = parent
	count += 1
	return p
end
local function folder(name)
	local f = Instance.new("Folder") f.Name = name f.Parent = root return f
end
local function yaw(deg) return CFrame.Angles(0, math.rad(deg), 0) end

-- ground: light granite pavers, brown accent tiles
local ground = folder("Ground")
for _, s in ipairs(PAVERS) do
	part(ground, "Pavers", Vector3.new(s[3], PAVE, s[4]), CFrame.new(s[1], PAVE / 2, s[2]), Enum.Material.CeramicTiles, {200, 198, 192}, {CastShadow = false})
end
for _, w in ipairs(PAVE_EDGE) do
	part(ground, "Border", Vector3.new(w[3], PAVE, 1.6), CFrame.new(w[1], PAVE / 2, w[2]) * yaw(w[4]), Enum.Material.CeramicTiles, {200, 198, 192}, {CastShadow = false})
end
for _, t in ipairs(ACCENT) do
	part(ground, "Accent", Vector3.new(1.7, 0.04, 1.7), CFrame.new(t[1], PAVE + 0.02, t[2]), Enum.Material.Slate, {146, 82, 58}, {CastShadow = false, CanCollide = false})
end

-- raised planters: dark split-face block wall, gravel and soil inside
local beds = folder("Planters")
local WALL_H, FILL_TOP = 1.9, PAVE + 1.6
for _, w in ipairs(BED_WALL) do
	part(beds, "Wall", Vector3.new(w[3], WALL_H, 1.1), CFrame.new(w[1], PAVE + WALL_H / 2, w[2]) * yaw(w[4]), Enum.Material.Slate, {72, 72, 74})
	part(beds, "Cap", Vector3.new(w[3], 0.15, 1.3), CFrame.new(w[1], PAVE + WALL_H + 0.075, w[2]) * yaw(w[4]), Enum.Material.Concrete, {92, 92, 94}, {CastShadow = false})
end
for _, s in ipairs(BED_FILL) do
	part(beds, "Soil", Vector3.new(s[3], FILL_TOP - PAVE, s[4]), CFrame.new(s[1], (FILL_TOP + PAVE) / 2, s[2]), Enum.Material.Pebble, {132, 126, 112}, {CastShadow = false})
end
local plants = folder("Plants")
local Kits = game:GetService("ServerStorage"):WaitForChild("Kits")
local function bush(name, kit, size, cf, rgb)  -- a crown kit mesh squashed or stretched into a clump or a slim conifer
	local m = Kits[kit]:Clone()
	m.Name = name m.Anchored = true m.CanCollide = false m.CastShadow = false m.Size = size m.CFrame = cf
	m.Material = Enum.Material.LeafyGrass m.Color = Color3.fromRGB(rgb[1], rgb[2], rgb[3]) m.Parent = plants
	count += 1
end
for i, p in ipairs(PLANTS) do
	local x, z, kind, s = p[1], p[2], p[3], p[4]
	local kit = (i % 2 == 0) and "crown-1" or "crown-2"
	local turn = CFrame.Angles(0, math.rad(i * 47 % 360), 0)
	if kind == 0 then -- ornamental grass and shrub clumps
		local d = 2.2 + s * 1.8
		local g = (s < 0.35) and {168, 170, 76} or (s < 0.7) and {112, 138, 66} or {82, 112, 58}
		bush("Grass", kit, Vector3.new(d, d * 0.55, d), CFrame.new(x, FILL_TOP + d * 0.2, z) * turn, g)
	elseif kind == 1 then -- white stone ball
		local d = 1.4 + s * 0.8
		part(plants, "StoneBall", Vector3.new(d, d, d), CFrame.new(x, FILL_TOP + d * 0.4, z), Enum.Material.Marble, {236, 234, 228}, {Shape = Enum.PartType.Ball})
	elseif kind == 2 then -- slim conifer
		local h = 4 + s * 4
		bush("Conifer", kit, Vector3.new(h * 0.32, h, h * 0.32), CFrame.new(x, FILL_TOP + h * 0.45, z) * turn, {40, 84, 50})
	else -- flowering perennial
		local d = 1.4 + s * 0.8
		bush("Flower", kit, Vector3.new(d, d * 0.6, d), CFrame.new(x, FILL_TOP + d * 0.2, z) * turn, (s < 0.5) and {138, 104, 172} or {214, 196, 80})
	end
end

-- the stepped oval of dark stone (seats in tiers)
local terrace = folder("Terrace")
for _, s in ipairs(TERRACE) do
	local top = PAVE + 1.4 * (s[5] + 1)
	part(terrace, "Step" .. (s[5] + 1), Vector3.new(s[3], 1.4, s[4]), CFrame.new(s[1], top - 0.7, s[2]), Enum.Material.Slate, {58, 58, 62})
end
for _, w in ipairs(TERRACE_EDGE) do
	local top = PAVE + 1.4 * (w[5] + 1)
	part(terrace, "Edge" .. (w[5] + 1), Vector3.new(w[3], 1.4, 1.8), CFrame.new(w[1], top - 0.7, w[2]) * yaw(w[4]), Enum.Material.Slate, {58, 58, 62})
end

-- tree beds: lawn behind a low granite curb (the trees come with the cell)
local groves = folder("TreeBeds")
for _, s in ipairs(GROVE_FILL) do
	part(groves, "Lawn", Vector3.new(s[3], 0.5, s[4]), CFrame.new(s[1], PAVE + 0.25, s[2]), Enum.Material.LeafyGrass, {74, 104, 52}, {CastShadow = false})
end
for _, w in ipairs(GROVE_CURB) do
	part(groves, "Curb", Vector3.new(w[3], 0.7, 0.8), CFrame.new(w[1], PAVE + 0.35, w[2]) * yaw(w[4]), Enum.Material.Granite, {170, 168, 162})
end

-- the diagonal row of white columns and the tall brown posts
local art = folder("Columns")
for _, c in ipairs(COLUMNS) do
	part(art, "Column", Vector3.new(20, 2.4, 2.4), CFrame.new(c[1], PAVE + 10, c[2]) * CFrame.Angles(0, 0, math.rad(90)), Enum.Material.SmoothPlastic, {238, 238, 234}, {Shape = Enum.PartType.Cylinder})
	part(art, "Base", Vector3.new(0.5, 3, 3), CFrame.new(c[1], PAVE + 0.25, c[2]) * CFrame.Angles(0, 0, math.rad(90)), Enum.Material.Concrete, {205, 205, 200}, {Shape = Enum.PartType.Cylinder})
end
for i, p in ipairs(POLES) do
	part(art, "Post", Vector3.new(1.3, p[3], 1.3), CFrame.new(p[1], PAVE + p[3] / 2, p[2]) * yaw(17 * i) * CFrame.Angles(math.rad(2), 0, math.rad(-1.5)), Enum.Material.Wood, {164, 84, 44})
end

-- lamps: black post with two round heads
local lamps = folder("Lamps")
for _, l in ipairs(LAMPS) do
	part(lamps, "Post", Vector3.new(14, 0.45, 0.45), CFrame.new(l[1], PAVE + 7, l[2]) * CFrame.Angles(0, 0, math.rad(90)), Enum.Material.Metal, {32, 32, 34}, {Shape = Enum.PartType.Cylinder})
	part(lamps, "Arm", Vector3.new(3.4, 0.25, 0.25), CFrame.new(l[1], PAVE + 13.6, l[2]), Enum.Material.Metal, {32, 32, 34})
	for _, dx in ipairs({-1.6, 1.6}) do
		local head = part(lamps, "Head", Vector3.new(1.1, 1.1, 1.1), CFrame.new(l[1] + dx, PAVE + 13.2, l[2]), Enum.Material.Neon, {250, 236, 200}, {Shape = Enum.PartType.Ball})
		local light = Instance.new("PointLight") light.Range = 16 light.Brightness = 0.8 light.Color = Color3.fromRGB(255, 228, 180) light.Parent = head
	end
end

-- glass pavilions over the escalators and stairs to the underground mall and car park
local ROOF = { teal = {48, 92, 96}, brown = {96, 70, 52} }
local pav = folder("Pavilions")
local function sign(p, face, text)
	local gui = Instance.new("SurfaceGui") gui.Face = face gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud gui.PixelsPerStud = 20
	gui.LightInfluence = 1 gui.MaxDistance = 250 gui.Parent = p
	local t = Instance.new("TextLabel") t.Size = UDim2.fromScale(1, 1) t.BackgroundTransparency = 1 t.Text = text t.TextScaled = true
	t.Font = Enum.Font.GothamBold t.TextColor3 = Color3.fromRGB(245, 245, 240) t.Parent = gui
end
for n, v in ipairs(PAVILIONS) do
	local x, z, w, d, h, door, text, roof = v[1], v[2], v[3], v[4], v[5], v[6], v[7], v[8]
	local m = Instance.new("Model") m.Name = "Pavilion" .. n m.Parent = pav
	part(m, "Floor", Vector3.new(w, 0.3, d), CFrame.new(x, PAVE + 0.15, z), Enum.Material.Granite, {120, 118, 114})
	part(m, "Well", Vector3.new(w * 0.5, 0.05, d * 0.6), CFrame.new(x, PAVE + 0.33, z), Enum.Material.SmoothPlastic, {22, 22, 24}, {CanCollide = false})
	local sides = { N = {x, z - d / 2, w, 0}, S = {x, z + d / 2, w, 0}, E = {x + w / 2, z, d, 90}, W = {x - w / 2, z, d, 90} }
	for key, s in sides do
		local len = s[3]
		local cf = CFrame.new(s[1], PAVE + h / 2, s[2]) * yaw(s[4])
		if key == door then -- glass either side of a 5-stud doorway
			local side = (len - 5) / 2
			for _, k in ipairs({-1, 1}) do
				part(m, "Glass", Vector3.new(side, h, 0.3), cf * CFrame.new(k * (len / 2 - side / 2), 0, 0), Enum.Material.Glass, {150, 196, 196}, {Transparency = 0.45})
			end
			part(m, "Lintel", Vector3.new(5, 1.2, 0.5), cf * CFrame.new(0, h / 2 - 0.6, 0), Enum.Material.Metal, {60, 62, 64})
		else
			part(m, "Glass", Vector3.new(len, h, 0.3), cf, Enum.Material.Glass, {150, 196, 196}, {Transparency = 0.45})
		end
		for k = 0, math.floor(len / 4) do -- mullions every 4 studs
			part(m, "Mullion", Vector3.new(0.3, h, 0.5), cf * CFrame.new(-len / 2 + math.min(k * 4, len), 0, 0), Enum.Material.Metal, {60, 62, 64})
		end
	end
	local band = part(m, "Band", Vector3.new(w + 0.6, 2.2, d + 0.6), CFrame.new(x, PAVE + h + 1.1, z), Enum.Material.Metal, ROOF[roof])
	part(m, "Roof", Vector3.new(w + 2.4, 0.5, d + 2.4), CFrame.new(x, PAVE + h + 2.45, z), Enum.Material.Metal, {70, 72, 74})
	if text ~= "" then
		local face = ({ N = Enum.NormalId.Front, S = Enum.NormalId.Back, E = Enum.NormalId.Right, W = Enum.NormalId.Left })[door]
		sign(band, face, text)
	end
end

-- the red-roofed shelter among the north-west trees
do
	local k = KIOSK[1]
	local x, z, w, d, h = k[1], k[2], k[3], k[4], k[5]
	local m = Instance.new("Model") m.Name = "Shelter" m.Parent = pav
	for _, sx in ipairs({-1, 1}) do
		for _, sz in ipairs({-1, 1}) do
			part(m, "Post", Vector3.new(0.6, h, 0.6), CFrame.new(x + sx * (w / 2 - 0.6), PAVE + h / 2, z + sz * (d / 2 - 0.6)), Enum.Material.Wood, {90, 66, 50})
		end
	end
	part(m, "Roof", Vector3.new(w + 1.5, 0.8, d + 1.5), CFrame.new(x, PAVE + h + 0.4, z), Enum.Material.SmoothPlastic, {186, 52, 60})
	part(m, "Bench", Vector3.new(w - 3, 1.4, 1.6), CFrame.new(x, PAVE + 0.7, z), Enum.Material.Wood, {120, 86, 58})
end

root.Parent = manual
return string.format("Manual/Plaza v1: %d parts", count)
