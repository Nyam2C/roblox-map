-- Manual 래미안 부천중동 (7 towers, cells 8930e0af133ffff and 8930e0af1abffff), v1 (2026-10-15). Generated by src/raemian.py from the
-- tower records, the site plan and street view; change raemian.py, not the tables. The claims carry BuildingId so the Auto building of
-- every record on the site (tower records, V-World fragments, OSM outlines) steps aside (MapBuilder BR-2.8).
-- Creates only; never destroys anything. Made only when Manual/Raemian does not exist; to redo it delete Manual/Raemian and run this again.
local manual = workspace:FindFirstChild("Manual")
if not manual then manual = Instance.new("Folder") manual.Name = "Manual" manual.Parent = workspace end
if manual:FindFirstChild("Raemian") then return "Manual/Raemian is already there: left alone" end
local root = Instance.new("Model") root.Name = "Raemian"
--[[DATA]]
local count = 0
local WHITE, PANEL, GLASS, SLAB = {238, 238, 234}, {196, 198, 200}, {150, 170, 182}, {246, 246, 244}
local END_A, END_B, CROWN, STONE = {150, 152, 156}, {112, 114, 118}, {92, 96, 102}, {70, 72, 76}
local ACCENT = { yellow = {226, 182, 74}, blue = {74, 120, 178}, pink = {214, 150, 162}, orange = {222, 142, 78}, gray = {130, 132, 136} }
local function part(parent, name, size, cf, material, rgb, opts)
	local p = Instance.new("Part")
	p.Name = name p.Anchored = true p.Size = size p.CFrame = cf
	p.Material = material p.Color = Color3.fromRGB(rgb[1], rgb[2], rgb[3])
	p.TopSurface = Enum.SurfaceType.Smooth p.BottomSurface = Enum.SurfaceType.Smooth
	if opts then for k, v in opts do p[k] = v end end
	p.Parent = parent
	count += 1
	return p
end
local function yaw(deg) return CFrame.Angles(0, math.rad(deg), 0) end

-- claims: one marker per record on the site, so Auto leaves them all to this script
local claims = Instance.new("Folder") claims.Name = "Claims" claims.Parent = root
for _, c in ipairs(CLAIMS) do
	local f = Instance.new("Configuration") f.Name = c[1] f:SetAttribute("BuildingId", c[1]) f.Parent = claims
end

local models = {}
for _, t in ipairs(TOWERS) do
	local m = Instance.new("Model") m.Name = t[2] .. "동" m.Parent = root
	m.ModelStreamingMode = Enum.ModelStreamingMode.Persistent -- tall: seen from far away
	models[t[1]] = { model = m, dong = t[2], floors = t[3], top = t[4], accent = ACCENT[t[5]] or ACCENT.gray, podium = t[6] == 1 }
end

for _, b in ipairs(BODY) do
	local T = models[b[1]]
	part(T.model, "Core", Vector3.new(b[4], T.top, b[5]), CFrame.new(b[2], T.top / 2, b[3]), Enum.Material.SmoothPlastic, WHITE)
end
for _, b in ipairs(ROOF) do
	local T = models[b[1]]
	part(T.model, "Roof", Vector3.new(b[4], 0.6, b[5]), CFrame.new(b[2], T.top - 0.1, b[3]), Enum.Material.Concrete, {150, 152, 150}, {CastShadow = false})
end

for _, w in ipairs(WALLS) do
	local T = models[w[1]]
	local x, z, len, yawDeg, nx, nz, kind, strip = w[2], w[3], w[4], w[5], w[6], w[7], w[8], w[9]
	local FH = T.top / T.floors
	local base = T.podium and FH * 2 or 0
	local crownH = FH
	local at = function(out, y) return CFrame.new(x + nx * out, y, z + nz * out) * yaw(yawDeg) end
	local h = T.top - base - crownH
	if kind == 1 then -- balcony face: a white wall, a window band with a rail per floor, gray panels at the ends
		part(T.model, "Wall", Vector3.new(len, h, 0.6), at(0.3, base + h / 2), Enum.Material.SmoothPlastic, WHITE)
		for f = (T.podium and 2 or 0), T.floors - 2 do
			local y = f * FH
			part(T.model, "Window", Vector3.new(len - 6, FH * 0.52, 0.2), at(0.68, y + FH * 0.5), Enum.Material.Glass, GLASS, {Reflectance = 0.1, CastShadow = false, CanCollide = false})
			part(T.model, "Rail", Vector3.new(len - 6, 0.15, 0.2), at(0.95, y + FH * 0.42), Enum.Material.Metal, {200, 204, 208}, {CastShadow = false, CanCollide = false})
		end
		for _, side in ipairs({-1, 1}) do
			part(T.model, "EndPanel", Vector3.new(3, h, 1.2), at(0.6, base + h / 2) * CFrame.new(side * (len / 2 - 1.5), 0, 0), Enum.Material.SmoothPlastic, PANEL)
		end
		if strip == 1 then
			part(T.model, "Accent", Vector3.new(2.2, h, 1.4), at(0.75, base + h / 2) * CFrame.new(len * 0.18, 0, 0), Enum.Material.SmoothPlastic, T.accent)
		end
	else -- narrow end: gray wall with a darker band every two floors
		part(T.model, "End", Vector3.new(len, h, 1.2), at(0.6, base + h / 2), Enum.Material.SmoothPlastic, END_A)
		for f = (T.podium and 2 or 0), T.floors - 2, 2 do
			part(T.model, "EndBand", Vector3.new(len, FH * 0.9, 0.2), at(1.25, f * FH + FH * 0.55), Enum.Material.SmoothPlastic, END_B, {CastShadow = false, CanCollide = false})
		end
		if len >= 14 then -- the dong number near the top
			local plate = part(T.model, "Number", Vector3.new(math.min(len - 2, 16), 6, 0.2), at(1.4, T.top - crownH - 6), Enum.Material.SmoothPlastic, END_A, {CanCollide = false, Transparency = 1})
			local gui = Instance.new("SurfaceGui") gui.Face = (plate.CFrame.LookVector:Dot(Vector3.new(nx, 0, nz)) > 0) and Enum.NormalId.Front or Enum.NormalId.Back gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud gui.PixelsPerStud = 10
			gui.LightInfluence = 1 gui.MaxDistance = 600 gui.Parent = plate
			local tl = Instance.new("TextLabel") tl.Size = UDim2.fromScale(1, 1) tl.BackgroundTransparency = 1 tl.Text = T.dong tl.TextScaled = true
			tl.Font = Enum.Font.GothamBold tl.TextColor3 = Color3.fromRGB(70, 72, 78) tl.Parent = gui
		end
	end
	-- crown: a darker top floor and a parapet
	part(T.model, "Crown", Vector3.new(len, crownH, 1.0), at(0.5, T.top - crownH / 2), Enum.Material.SmoothPlastic, PANEL)
	part(T.model, "Parapet", Vector3.new(len, 1.6, 0.6), at(0.3, T.top + 0.8), Enum.Material.SmoothPlastic, CROWN)
	if T.podium then -- shop base: dark stone piers, glass fronts, a canopy
		part(T.model, "ShopGlass", Vector3.new(len, base, 0.4), at(-0.6, base / 2), Enum.Material.Glass, {40, 46, 52}, {Reflectance = 0.1})
		part(T.model, "Pier", Vector3.new(2.4, base, 2.4), at(0.6, base / 2) * CFrame.new(-len / 2, 0, 0), Enum.Material.Slate, STONE)
		part(T.model, "Lintel", Vector3.new(len, 1.4, 2.0), at(0.9, base - 0.7), Enum.Material.Slate, STONE)
		part(T.model, "Canopy", Vector3.new(len, 0.6, 5), at(2.8, FH * 1.05), Enum.Material.Metal, {64, 120, 108})
	end
end

-- rooftop frame on each tower
for _, T in models do
	local cf, size = T.model:GetBoundingBox()
	local w = math.min(size.X, size.Z) * 0.35
	for _, d in ipairs({{-1, -1}, {1, -1}, {1, 1}, {-1, 1}}) do
		part(T.model, "FramePost", Vector3.new(0.8, 6, 0.8), CFrame.new(cf.Position.X + d[1] * w, T.top + 3, cf.Position.Z + d[2] * w), Enum.Material.Metal, CROWN)
	end
	part(T.model, "FrameTop", Vector3.new(2 * w + 0.8, 0.8, 2 * w + 0.8), CFrame.new(cf.Position.X, T.top + 6, cf.Position.Z), Enum.Material.Metal, CROWN)
end

root.Parent = manual
return string.format("Manual/Raemian v1: %d parts, %d claims", count, #CLAIMS)
