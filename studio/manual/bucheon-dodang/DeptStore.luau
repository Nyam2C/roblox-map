local TOP, FLOORS = HEAD[1][1], HEAD[1][2]
local FH = TOP / FLOORS
local BASE_H = FH * 2 -- the dark two-floor glass base
local count = 0
local STONE, JOINT = {228, 224, 214}, {196, 192, 182}
local GLASS, MULLION, DARK = {92, 128, 156}, {180, 186, 190}, {34, 40, 46}
local function part(parent, name, size, cf, material, rgb, opts)
	local p = Instance.new("Part")
	p.Name = name p.Anchored = true p.Size = size p.CFrame = cf
	p.Material = material p.Color = Color3.fromRGB(rgb[1], rgb[2], rgb[3])
	p.TopSurface = Enum.SurfaceType.Smooth p.BottomSurface = Enum.SurfaceType.Smooth
	if opts then for k, v in opts do p[k] = v end end
	p.Parent = parent
	count += 1
	return p
end
local function folder(name) local f = Instance.new("Folder") f.Name = name f.Parent = root return f end
local function yaw(deg) return CFrame.Angles(0, math.rad(deg), 0) end

-- body: bands filling the outline (hidden behind the walls), with the roof slab on top
local body = folder("Body")
for _, s in ipairs(BODY) do
	part(body, "Core", Vector3.new(s[3], TOP, s[4]), CFrame.new(s[1], TOP / 2, s[2]), Enum.Material.SmoothPlastic, STONE)
end
for _, s in ipairs(ROOF) do -- the roof reaches the walls; the core stays inside so its corners never show
	part(body, "Roof", Vector3.new(s[3], 0.6, s[4]), CFrame.new(s[1], TOP - 0.1, s[2]), Enum.Material.Concrete, {150, 150, 146}, {CastShadow = false})
end

-- walls: one panel per outline edge; kind 0 stone, 1 tall glass curtain (east end of the drum), 2 glass block (middle of the drum),
-- 3 stone with a glass bay in the middle (long faces); base 1 = a dark glass shop base with piers and a canopy
local walls = folder("Walls")
for _, w in ipairs(WALLS) do
	local x, z, len, yawDeg, nx, nz, kind, base, piers = w[1], w[2], w[3], w[4], w[5], w[6], w[7], w[8], w[9]
	local at = function(out, y) return CFrame.new(x + nx * out, y, z + nz * out) * yaw(yawDeg) end
	local y0 = base == 1 and BASE_H or 0
	if kind == 1 then -- glass from the base to just under the roof edge, a mullion at the edge joint, a transom per floor
		part(walls, "Curtain", Vector3.new(len, TOP - y0 - 4, 0.6), at(0.3, (y0 + TOP - 4) / 2), Enum.Material.Glass, GLASS, {Reflectance = 0.15})
		part(walls, "Parapet", Vector3.new(len, 4, 1.4), at(0.6, TOP - 2), Enum.Material.SmoothPlastic, STONE)
		part(walls, "Mullion", Vector3.new(0.5, TOP - y0 - 4, 0.9), at(0.7, (y0 + TOP - 4) / 2) * CFrame.new(-len / 2, 0, 0), Enum.Material.Metal, MULLION)
		for f = (base == 1 and 2 or 1), FLOORS - 1 do
			part(walls, "Transom", Vector3.new(len, 0.35, 0.8), at(0.7, f * FH), Enum.Material.Metal, MULLION, {CastShadow = false})
		end
	else
		part(walls, "Stone", Vector3.new(len, TOP - y0, 1.4), at(0.6, (y0 + TOP) / 2), Enum.Material.SmoothPlastic, STONE)
		for f = (base == 1 and 3 or 1), FLOORS - 1 do -- a joint per floor
			part(walls, "Joint", Vector3.new(len, 0.25, 0.1), at(1.32, f * FH), Enum.Material.SmoothPlastic, JOINT, {CastShadow = false, CanCollide = false})
		end
		if kind == 2 then -- a glass block over floors 5 to 9
			part(walls, "Window", Vector3.new(len, FH * 5 - 1, 0.3), at(1.35, FH * 6.5), Enum.Material.Glass, GLASS, {Reflectance = 0.15})
			part(walls, "Mullion", Vector3.new(0.5, FH * 5 - 1, 0.5), at(1.45, FH * 6.5) * CFrame.new(-len / 2, 0, 0), Enum.Material.Metal, MULLION)
		elseif kind == 3 then -- a glass bay 18 studs wide in the middle of a long face, floors 3 to the top
			part(walls, "Bay", Vector3.new(18, TOP - FH * 2 - 6, 0.6), at(1.5, (FH * 2 + TOP - 6) / 2), Enum.Material.Glass, GLASS, {Reflectance = 0.15})
			for k = -1, 1 do
				part(walls, "BayFin", Vector3.new(0.5, TOP - FH * 2 - 6, 1.2), at(1.7, (FH * 2 + TOP - 6) / 2) * CFrame.new(k * 9, 0, 0), Enum.Material.Metal, MULLION)
			end
		end
	end
	if base == 1 then -- dark glass shop base, a stone pier at the edge joint, a canopy over the doors
		part(walls, "ShopGlass", Vector3.new(len, BASE_H, 0.4), at(-1.2, BASE_H / 2), Enum.Material.Glass, DARK, {Reflectance = 0.1})
		for k = 0, piers - 1 do
			part(walls, "Pier", Vector3.new(2.6, BASE_H, 2.6), at(0.4, BASE_H / 2) * CFrame.new(-len / 2 + k * len / piers, 0, 0), Enum.Material.SmoothPlastic, STONE)
		end
		part(walls, "Lintel", Vector3.new(len, 1.2, 1.6), at(0.6, BASE_H - 0.6), Enum.Material.SmoothPlastic, STONE)
		part(walls, "Canopy", Vector3.new(len, 0.8, 7), at(3.4, FH * 1.15), Enum.Material.Metal, {210, 212, 214})
	end
end

-- rooftop plant boxes
local top = folder("Rooftop")
for _, r in ipairs(ROOFTOP) do
	part(top, "Plant", Vector3.new(r[3], r[5], r[4]), CFrame.new(r[1], TOP + r[5] / 2, r[2]), Enum.Material.Metal, {176, 178, 180})
	part(top, "Vent", Vector3.new(r[3] * 0.3, 1, r[4] * 0.5), CFrame.new(r[1], TOP + r[5] + 0.5, r[2]), Enum.Material.Metal, {120, 124, 128})
end

root.Parent = manual
return string.format("Manual/DeptStore v1: %d parts, top %.1f studs", count, TOP)
