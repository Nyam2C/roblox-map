local PAVE = 0.38
local count = 0
local function part(parent, name, size, cf, material, rgb, opts)
	local p = Instance.new("Part")
	p.Name = name p.Anchored = true p.Size = size p.CFrame = cf
	p.Material = material p.Color = Color3.fromRGB(rgb[1], rgb[2], rgb[3])
	p.TopSurface = Enum.SurfaceType.Smooth p.BottomSurface = Enum.SurfaceType.Smooth
	if opts then for k, v in opts do p[k] = v end end
	p.Parent = parent
	count += 1
	return p
end
local function folder(name)
	local f = Instance.new("Folder") f.Name = name f.Parent = root return f
end
local function yaw(deg) return CFrame.Angles(0, math.rad(deg), 0) end

-- ground: light granite pavers, brown accent tiles
local ground = folder("Ground")
for _, s in ipairs(PAVERS) do
	part(ground, "Pavers", Vector3.new(s[3], PAVE, s[4]), CFrame.new(s[1], PAVE / 2, s[2]), Enum.Material.CeramicTiles, {200, 198, 192}, {CastShadow = false})
end
for _, w in ipairs(PAVE_EDGE) do
	part(ground, "Border", Vector3.new(w[3], PAVE, 1.6), CFrame.new(w[1], PAVE / 2, w[2]) * yaw(w[4]), Enum.Material.CeramicTiles, {200, 198, 192}, {CastShadow = false})
