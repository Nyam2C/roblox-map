-- raised planters: dark split-face block wall, gravel and soil inside
local beds = folder("Planters")
local WALL_H, FILL_TOP = 1.9, PAVE + 1.6
for _, w in ipairs(BED_WALL) do
	part(beds, "Wall", Vector3.new(w[3], WALL_H, 1.1), CFrame.new(w[1], PAVE + WALL_H / 2, w[2]) * yaw(w[4]), Enum.Material.Slate, {72, 72, 74})
	part(beds, "Cap", Vector3.new(w[3], 0.15, 1.3), CFrame.new(w[1], PAVE + WALL_H + 0.075, w[2]) * yaw(w[4]), Enum.Material.Concrete, {92, 92, 94}, {CastShadow = false})
end
for _, s in ipairs(BED_FILL) do
	part(beds, "Soil", Vector3.new(s[3], FILL_TOP - PAVE, s[4]), CFrame.new(s[1], (FILL_TOP + PAVE) / 2, s[2]), Enum.Material.Pebble, {132, 126, 112}, {CastShadow = false})
end
local plants = folder("Plants")
local Kits = game:GetService("ServerStorage"):WaitForChild("Kits")
local function bush(name, kit, size, cf, rgb)  -- a crown kit mesh squashed or stretched into a clump or a slim conifer
	local m = Kits[kit]:Clone()
	m.Name = name m.Anchored = true m.CanCollide = false m.CastShadow = false m.Size = size m.CFrame = cf
	m.Material = Enum.Material.LeafyGrass m.Color = Color3.fromRGB(rgb[1], rgb[2], rgb[3]) m.Parent = plants
	count += 1
end
for i, p in ipairs(PLANTS) do
	local x, z, kind, s = p[1], p[2], p[3], p[4]
	local kit = (i % 2 == 0) and "crown-1" or "crown-2"
	local turn = CFrame.Angles(0, math.rad(i * 47 % 360), 0)
	if kind == 0 then -- ornamental grass and shrub clumps
		local d = 2.2 + s * 1.8
		local g = (s < 0.35) and {168, 170, 76} or (s < 0.7) and {112, 138, 66} or {82, 112, 58}
		bush("Grass", kit, Vector3.new(d, d * 0.55, d), CFrame.new(x, FILL_TOP + d * 0.2, z) * turn, g)
	elseif kind == 1 then -- white stone ball
		local d = 1.4 + s * 0.8
		part(plants, "StoneBall", Vector3.new(d, d, d), CFrame.new(x, FILL_TOP + d * 0.4, z), Enum.Material.Marble, {236, 234, 228}, {Shape = Enum.PartType.Ball})
	elseif kind == 2 then -- slim conifer
		local h = 4 + s * 4
		bush("Conifer", kit, Vector3.new(h * 0.32, h, h * 0.32), CFrame.new(x, FILL_TOP + h * 0.45, z) * turn, {40, 84, 50})
	else -- flowering perennial
		local d = 1.4 + s * 0.8
		bush("Flower", kit, Vector3.new(d, d * 0.6, d), CFrame.new(x, FILL_TOP + d * 0.2, z) * turn, (s < 0.5) and {138, 104, 172} or {214, 196, 80})
	end
end

