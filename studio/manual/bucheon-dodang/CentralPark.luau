-- Manual 부천중앙공원 (cell 8930e0af1cfffff), v1 (2026-10-15). Generated by src/park.py from regions/bucheon-dodang/central_park.json;
-- change those, not the tables. Creates only; made only when Manual/CentralPark does not exist (to redo it delete it and run again).
local manual = workspace:FindFirstChild("Manual")
if not manual then manual = Instance.new("Folder") manual.Name = "Manual" manual.Parent = workspace end
if manual:FindFirstChild("CentralPark") then return "Manual/CentralPark is already there: left alone" end
local root = Instance.new("Folder") root.Name = "CentralPark"
local D = {paths = {}, plazas = {}, lawns = {{step = 8.0, strips = {}}, {step = 8.0, strips = {}}, {step = 8.0, strips = {}}, {step = 8.0, strips = {}}, {step = 8.0, strips = {}}, {step = 8.0, strips = {}}, {step = 8.0, strips = {}}, {step = 8.0, strips = {}}, {step = 8.0, strips = {}}, {step = 8.0, strips = {}}, {step = 8.0, strips = {}}, {step = 8.0, strips = {}}, {step = 8.0, strips = {}}, {step = 8.0, strips = {}}, {step = 8.0, strips = {}}, {step = 8.0, strips = {}}, {step = 8.0, strips = {}}}, water = {{step = 8.0, strips = {}}, {step = 8.0, strips = {}}}, domes = {}, tower = nil, stage = nil}
local S = 3.6
local TOP = 0.42
local count = 0
local function part(parent, name, size, cf, material, rgb, opts)
	local p = Instance.new("Part")
	p.Name = name p.Anchored = true p.Size = size p.CFrame = cf
	p.Material = material p.Color = Color3.fromRGB(rgb[1], rgb[2], rgb[3])
	p.TopSurface = Enum.SurfaceType.Smooth p.BottomSurface = Enum.SurfaceType.Smooth
	if opts then for k, v in opts do p[k] = v end end
	p.Parent = parent
	count += 1
	return p
end
local function model(name)
	local m = Instance.new("Model") m.Name = name
	m:SetAttribute("Settle", "high")
	m.Parent = root
	return m
end
-- paths: one flat strip per segment, deep enough to fill under the slope
for i, pth in ipairs(D.paths) do
	local m = model("Path" .. i)
	for k = 1, #pth.pts - 1 do
		local a, b = pth.pts[k], pth.pts[k + 1]
		local dx, dz = b[1] - a[1], b[2] - a[2]
		local len = math.sqrt(dx * dx + dz * dz)
		if len > 0.5 then
			local cf = CFrame.lookAt(Vector3.new((a[1] + b[1]) / 2, TOP - 1.5, (a[2] + b[2]) / 2), Vector3.new(b[1], TOP - 1.5, b[2]))
			part(m, "Walk", Vector3.new(pth.w, 3, len + pth.w * 0.5), cf, Enum.Material.Pavement, pth.rgb)
		end
	end
end
for i, l in ipairs(D.lawns) do
	local m = model("Lawn" .. i)
	for _, r in ipairs(l.strips) do -- the polygon as strips along X: {x0, x1, z}
		part(m, "Grass", Vector3.new(r[2] - r[1], 2, l.step), CFrame.new((r[1] + r[2]) / 2, TOP - 1.2, r[3]), Enum.Material.Grass, {98, 140, 70})
	end
end
for i, w in ipairs(D.water) do
	local m = model("Pond" .. i)
	for _, r in ipairs(w.strips) do
		part(m, "Water", Vector3.new(r[2] - r[1], 2, w.step), CFrame.new((r[1] + r[2]) / 2, TOP - 1.4, r[3]), Enum.Material.Glass, {70, 120, 150}, { Transparency = 0.2, CanCollide = false })
		part(m, "Bed", Vector3.new(r[2] - r[1], 2, w.step), CFrame.new((r[1] + r[2]) / 2, TOP - 2.6, r[3]), Enum.Material.Slate, {60, 70, 75})
	end
end
for i, pz in ipairs(D.plazas) do
	local m = model("Plaza" .. i)
	if pz.kind == "square" then
		part(m, "Paving", Vector3.new(2 * pz.r, 6, 2 * pz.r), CFrame.new(pz.x, TOP - 3.0, pz.z), Enum.Material.Pavement, pz.rgb)
	else
		part(m, "Paving", Vector3.new(6, 2 * pz.r, 2 * pz.r), CFrame.new(pz.x, TOP - 3.0, pz.z) * CFrame.Angles(0, 0, math.rad(90)), Enum.Material.Pavement, pz.rgb, { Shape = Enum.PartType.Cylinder })
		part(m, "Ring", Vector3.new(0.1, 1.4 * pz.r, 1.4 * pz.r), CFrame.new(pz.x, TOP + 0.02, pz.z) * CFrame.Angles(0, 0, math.rad(90)), Enum.Material.Pavement, {170, 120, 100}, { Shape = Enum.PartType.Cylinder, CanCollide = false })
	end
	for k = 1, 6 do
		local a = math.rad(60 * k)
		part(m, "Bench", Vector3.new(1.8 * S, 0.45 * S, 0.5 * S), CFrame.new(pz.x, TOP, pz.z) * CFrame.Angles(0, a, 0) * CFrame.new(0, 0.22 * S, -pz.r + 0.8 * S), Enum.Material.Wood, {140, 100, 70}, { CanCollide = true })
	end
end
for i, dm in ipairs(D.domes) do
	local m = model("Dome" .. i)
	part(m, "Dome", Vector3.new(2 * dm.r, 2 * dm.r, 2 * dm.r), CFrame.new(dm.x, TOP, dm.z), Enum.Material.Glass, dm.rgb, { Shape = Enum.PartType.Ball, Transparency = 0.25, CanCollide = true })
	part(m, "Base", Vector3.new(4, 2 * dm.r + 1, 2 * dm.r + 1), CFrame.new(dm.x, TOP - 1.6, dm.z) * CFrame.Angles(0, 0, math.rad(90)), Enum.Material.Concrete, {180, 178, 172}, { Shape = Enum.PartType.Cylinder })
end
if D.tower then
	local t = D.tower
	local m = model("SymbolTower")
	local h = t.h
	part(m, "Plinth", Vector3.new(4 * S, 1.2 * S, 4 * S), CFrame.new(t.x, TOP + 0.6 * S, t.z), Enum.Material.Granite, {170, 168, 160}, { CanCollide = true })
	for k = 0, 2 do -- three slim blades leaning in, joined at the top
		local a = math.rad(120 * k)
		local foot = CFrame.new(t.x, TOP + 1.2 * S, t.z) * CFrame.Angles(0, a, 0) * CFrame.new(0, 0, 1.4 * S)
		local top = Vector3.new(t.x, TOP + 1.2 * S + h, t.z)
		local mid = (foot.Position + top) / 2
		part(m, "Blade", Vector3.new(0.9 * S, (top - foot.Position).Magnitude, 0.35 * S), CFrame.lookAt(mid, mid + (foot.Position - top).Unit:Cross(Vector3.yAxis), (top - foot.Position).Unit), Enum.Material.Metal, t.rgb, { CanCollide = true })
	end
	part(m, "Crown", Vector3.new(1.4 * S, 1.4 * S, 1.4 * S), CFrame.new(t.x, TOP + 1.2 * S + h, t.z), Enum.Material.Metal, t.rgb, { Shape = Enum.PartType.Ball })
end
if D.stage then
	local g = D.stage
	local m = model("Stage")
	local at = CFrame.new(g.x, TOP, g.z) * CFrame.Angles(0, math.rad(g.yaw), 0)
	part(m, "Deck", Vector3.new(g.w, 1.2 * S, g.d), at * CFrame.new(0, 0.6 * S - 2, 0), Enum.Material.Concrete, {190, 186, 178}, { CanCollide = true })
	part(m, "Back", Vector3.new(g.w, 6 * S, 0.6 * S), at * CFrame.new(0, 3 * S, g.d / 2), Enum.Material.Concrete, {220, 218, 212}, { CanCollide = true })
	part(m, "Roof", Vector3.new(g.w + 2 * S, 0.6 * S, g.d + 2 * S), at * CFrame.new(0, 6.3 * S, 0), Enum.Material.Metal, {235, 235, 232})
	for _, sx in ipairs({ -1, 1 }) do
		part(m, "Post", Vector3.new(0.6 * S, 6 * S, 0.6 * S), at * CFrame.new(sx * (g.w / 2), 3 * S, -g.d / 2), Enum.Material.Metal, {200, 200, 198}, { CanCollide = true })
	end
end
root.Parent = manual
return string.format("Manual/CentralPark made: %d parts", count)
