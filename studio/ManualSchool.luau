-- a box dragged from Auto (S-14: Auto skips the whole building whose id is under Manual)
local dr = folder("Dragged")
local cell = ws:FindFirstChild("Auto") and ws.Auto:FindFirstChild("8930e0af13bffff")
local dragged = 0
if cell then
	for _, fold in ipairs(cell:GetChildren()) do
		for _, p in ipairs(fold:GetChildren()) do
			if p:GetAttribute("BuildingId") == "gis:15839722" then local c = p:Clone() c.Parent = dr dragged += 1 end
		end
	end
end
return string.format("Manual/School made: %d parts (+%d dragged from Auto)", made, dragged)
