	part(m, "Roof", b0 * CFrame.new(0, 36.81 + rise / 2, s * half / 2) * turn, Vector3.new(185.558 + 3.6, rise, half), Enum.Material.Slate, {160, 62, 48}, { Shape = Enum.PartType.Wedge })
end

