-- gates: 정문 on the south edge near the south-east corner (옥산로113번길), 후문 on the north-east edge (계남로); marked by the user on the satellite photo (2026-10-13)
local gt = folder("Gate")
local function gate(name, cx, cz, edgeYaw, nx, nz, plateYaw, halfWidth, text)
	local gc = Vector3.new(cx, 0, cz)
	local along = yaw(edgeYaw).RightVector
	for _, s in ipairs({-1, 1}) do
		part(gt, name .. "Pillar", CFrame.new(gc + along * (s * halfWidth) + Vector3.new(0, 4.5, 0)) * yaw(edgeYaw), Vector3.new(3.6, 9, 3.6), Enum.Material.Concrete, {160, 160, 155})
	end
	if text then
		local outN = Vector3.new(nx, 0, nz)
		local plate = part(gt, name .. "Plate", CFrame.new(gc + along * -halfWidth + outN * 1.95 + Vector3.new(0, 6.2, 0)) * yaw(plateYaw), Vector3.new(3.2, 1.2, 0.3), Enum.Material.SmoothPlastic, {60, 60, 65}, { CanCollide = false })
		local gui = Instance.new("SurfaceGui") gui.Face = Enum.NormalId.Front gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud gui.PixelsPerStud = 50 gui.LightInfluence = 1 gui.MaxDistance = 200 gui.Parent = plate
		local label = Instance.new("TextLabel") label.Size = UDim2.new(1, 0, 1, 0) label.BackgroundTransparency = 1 label.TextScaled = true label.Text = text label.TextColor3 = Color3.new(1, 1, 1) label.FontFace = Font.fromEnum(Enum.Font.SourceSansBold) label.Parent = gui
	end
end
